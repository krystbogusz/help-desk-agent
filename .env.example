# Copy this file to .env and fill in LLM_API_KEY. Never commit .env.
#
# The agent talks to any chat API in the OpenAI format, so these three settings choose the model.
# They are set for Google Gemini (free key: https://aistudio.google.com/apikey). Other addresses:
#   OpenAI: leave LLM_BASE_URL empty
#   Groq:   https://api.groq.com/openai/v1
#   Ollama: http://localhost:11434/v1 (on your own computer; any non-empty API key)

# Address of the API; empty means OpenAI itself.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# API key for that address.
LLM_API_KEY=
# Model name. Gemini 3.5 Flash-Lite has the largest free quota (15 requests per minute, 500 per day).
LLM_MODEL=gemini-3.5-flash-lite
